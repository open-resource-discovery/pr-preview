5,0.878]],["t/15",[6,1.445]],["t/22",[7,0.814,8,0.814,9,0.814,10,0.814,11,0.814,12,0.814,13,0.814]]],"invertedIndex":[["below",{"_index":1,"t":{"1":{"position":[[11,5]]}}}],["compon",{"_index":12,"t":{"22":{"position":[[51,9]]}}}],["discovery/overlay",{"_index":9,"t":{"22":{"position":[[15,17]]}}}],["editor",{"_index":10,"t":{"22":{"position":[[33,6]]}}}],["entri",{"_index":4,"t":{"1":{"position":[[46,5]]}}}],["everyth",{"_index":0,"t":{"1":{"position":[[0,10]]}}}],["export",{"_index":2,"t":{"1":{"position":[[20,8]]}}}],["instal",{"_index":6,"t":{"15":{"position":[[0,12]]}}}],["librari",{"_index":13,"t":{"22":{"position":[[61,7]]}}}],["open",{"_index":7,"t":{"22":{"position":[[0,5]]}}}],["packag",{"_index":3,"t":{"1":{"position":[[38,7]]}}}],["point",{"_index":5,"t":{"1":{"position":[[52,5]]}}}],["react",{"_index":11,"t":{"22":{"position":[[45,5]]}}}],["resourc",{"_index":8,"t":{"22":{"position":[[6,8]]}}}]],"pipeline":["stemmer"]}},{"documents":[],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[],"invertedIndex":[],"pipeline":["stemmer"]}},{"documents":[{"i":2,"t":"Everything below is exported from the package entry point @open-resource-discovery/overlay-editor (and the equivalent ./card-view subpath).","s":"API Reference","u":"/pr-preview/overlay-editor/pr-40/docs/api","h":"","p":1},{"i":5,"t":"Read-only renderer for an ORD Overlay document. Prop Type Description content string The overlay document as JSON or YAML text. The component parses content into the overlay store and renders the hero, target card, and patch list.","s":"OverlayCardView","u":"/pr-preview/overlay-editor/pr-40/docs/api","h":"#overlaycardview","p":1},{"i":8,"t":"Zustand store holding the parsed overlay and any parse error. Helper selectors: selectParsedOverlay — the parsed OrdOverlay, or null. selectParseError — the parse error message, or null.","s":"useOverlayStore","u":"/pr-preview/overlay-editor/pr-40/docs/api","h":"#useoverlaystore","p":1},{"i":10,"t":"Module-level theme store, persisted to localStorage under the ord-ui-theme key (shared with @open-resource-discovery/ui-components). useTheme() returns { theme, resolvedTheme, setTheme }. useThemeStore is the underlying Zustand store; call useThemeStore.getState().setTheme('light' | 'dark' | 'system') outside React.","s":"useTheme / useThemeStore","u":"/pr-preview/overlay-editor/pr-40/docs/api","h":"#usetheme--usethemestore","p":1},{"i":12,"t":"cn — the clsx + tailwind-merge class-name helper, re-exported from @open-resource-discovery/ui-components.","s":"Utilities","u":"/pr-preview/overlay-editor/pr-40/docs/api","h":"#utilities","p":1},{"i":14,"t":"OrdOverlay, OverlayAction, OverlayPatch, OverlayPerspective, OverlaySelector, OverlayTarget, OverlayVisibility, OverlayCardViewProps, OverlayState, Theme, ResolvedTheme.","s":"Types","u":"/pr-preview/overlay-editor/pr-40/docs/api","h":"#types","p":1},{"i":17,"t":"npm install @open-resource-discovery/overlay-editor react and react-dom (v18 or v19) are peer dependencies and must be installed by the host application.","s":"Installation","u":"/pr-preview/overlay-editor/pr-40/docs/getting-started","h":"#installation","p":15},{"i":19,"t":"Import the component and its stylesheet, then pass an overlay document (JSON or YAML text) via the content prop: import { OverlayCardView } from \"@open-resource-discovery/overlay-editor\"; import \"@open-resource-discovery/overlay-editor/styles\"; const overlay = JSON.stringify({ ordOverlay: \"0.1\", // ... }); export function App() { return <OverlayCardView content={overlay} />; } OverlayCardView also injects its layout CSS at runtime, so it renders correctly even if the ./styles import is omitted — importing the stylesheet is still recommended so styles are present on first paint.","s":"Basic usage","u":"/pr-preview/overlay-editor/pr-40/docs/getting-started","h":"#basic-usage","p":15},{"i":21,"t":"The component renders under an .ord-ui root and follows the shared @open-resource-discovery/ui-components two-layer token system. Light/dark mode is controlled by the library's theme store: import { useThemeStore } from \"@open-resource-discovery/overlay-editor\"; // Sync the component to your app's color mode: useThemeStore.getState().setTheme(\"dark\"); // 'light' | 'dark' | 'system' See the API Reference for the full exported surface.","s":"Theming","u":"/pr-preview/overlay-editor/pr-40/docs/getting-started","h":"#theming","p":15},{"i":23,"t":"@open-resource-discovery/overlay-editor is a React component library for viewing ORD Overlay 0.1 documents. An ORD Overlay is a JSON or YAML document (identified by ordOverlay: \"0.1\") that describes patches to apply to an existing API or metadata definition — OpenAPI, EDMX/OData, CSN Interop, an MCP server card, or an A2A agent card — without editing the original source. Each patch targets a concept in the underlying definition using a selector (for example an operation, an entity type, or a JSON path) and declares an action of update, merge, or remove.","s":"ORD Overlay Editor","u":"/pr-preview/overlay-editor/pr-40/docs/overview","h":"","p":22},{"i":25,"t":"OverlayCardView — a self-contained, read-only component that renders an overlay document as a card view: an overview hero, the patch target, and a searchable list of patches with per-patch selector chips, action badges, descriptions, tags, and syntax-highlighted payloads. A small theme store (useTheme / useThemeStore) and content store (useOverlayStore) that back the component.","s":"What's in the box","u":"/pr-preview/overlay-editor/pr-40/docs/overview","h":"#whats-in-the-box","p":22},{"i":27,"t":"Head to the Playground to browse predefined examples, edit the raw overlay JSON, and see the rendered card view update live. Learn how to install and embed the component in Getting Started.","s":"Try it","u":"/pr-preview/overlay-editor/pr-40/docs/overview","h":"#try-it","p":22}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/2",[0,2.784,1,2.784,2,1.368,3,2.784,4,2.784,5,2.784,